# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4001
SERVICE_VERSION=

# Logging
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty
# Comma-separated log paths to redact (optional, sensible defaults apply)
# LOG_REDACT=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=forms-identity-api

# Proxies (leave blank if not required)
HTTP_PROXY=
# Adds TRUSTSTORE_* CA certs to outbound TLS (defaults on in production)
ENABLE_SECURE_CONTEXT=false

# Tracing
TRACING_HEADER=x-cdp-request-id

# OIDC provider
# Public issuer URL — the forms-identity-ui façade origin (signed into tokens)
OIDC_ISSUER=http://localhost:3002
# Private signing JWKS (JSON). Generate with: node scripts/generate-jwks.mjs
OIDC_JWKS=
# Comma-separated cookie signing keys, identical across containers
OIDC_COOKIE_KEYS=
# Comma-separated redirect URIs registered for the 'runner' client
OIDC_RUNNER_REDIRECT_URIS=http://localhost:3000/callback
# Whether OIDC cookies are marked Secure (defaults to true in production)
OIDC_COOKIE_SECURE=false

# One-time codes
OTP_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
# GOV.UK Notify email delivery. The template must contain the
# ((code)) and ((expiry_minutes)) personalisation placeholders.
NOTIFY_API_KEY=
NOTIFY_OTP_TEMPLATE_ID=
