# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3010
SERVICE_VERSION=

# Logging
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty
# Comma-separated log paths to redact (optional, sensible defaults apply)
# LOG_REDACT=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=forms-identity-api

# Proxies (leave blank if not required)
HTTP_PROXY=
# Adds TRUSTSTORE_* CA certs to outbound TLS (defaults on in production)
ENABLE_SECURE_CONTEXT=false

# Tracing
TRACING_HEADER=x-cdp-request-id

# GOV.UK Notify (required — no defaults; ask the team for the real values)
NOTIFY_API_KEY=
NOTIFY_OTP_TEMPLATE_ID=
# Reply-to address id from the Notify console (Settings > Email reply-to
# addresses). Sending from a real reply-to address makes the security code
# email likelier to reach an inbox rather than a spam folder.
NOTIFY_REPLY_TO_ID=

# One-time codes (optional overrides)
# OTP_TTL_SECONDS=900
# OTP_MAX_ATTEMPTS=5
