# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4001
SERVICE_VERSION=

# Logging
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty
# Comma-separated log paths to redact (optional, sensible defaults apply)
# LOG_REDACT=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=forms-identity-api

# Proxies (leave blank if not required)
HTTP_PROXY=
# Adds TRUSTSTORE_* CA certs to outbound TLS (defaults on in production)
ENABLE_SECURE_CONTEXT=false

# Tracing
TRACING_HEADER=x-cdp-request-id
